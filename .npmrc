# Decisão registrada (fase 1): @codetrix-studio/capacitor-google-auth ainda
# declara peer @capacitor/core ^6.0.0, mas o app usa Capacitor 8 (spec: 7+).
# A superfície usada (initialize/signIn/signOut) é estável entre majors, então
# aceitamos a divergência de peer em vez de travar o Capacitor no 6.
legacy-peer-deps=true
