# Aponta para a API mobile em produção (repo Laravel irmão `yzap`,
# branch `mobile/api-lojista`, contrato em docs/mobile-api-contrato.md).
VITE_API_URL=https://yzap.com.br/api/mobile/v1
# Google Sign-In (Android/iOS/Web): client ID OAuth. Placeholder vazio de
# propósito — preencher por ambiente/build. NUNCA commitar o client secret
# (segredo de servidor; fica só no backend Laravel).
VITE_GOOGLE_CLIENT_ID=
# Scheme de deeplink para volta do browser externo (checkout MP).
VITE_APP_SCHEME=yzap
